# Copy to Backend/.env and fill in. Never commit the real file.
# Every variable below is required; the server exits at boot if one is missing.

# --- Neon Postgres -----------------------------------------------------------
# Pooled endpoint, used by the running server. Hostname contains "-pooler".
# pgbouncer=true is required: it disables prepared statements, which PgBouncer
# in transaction mode cannot preserve.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct (unpooled) endpoint, used by every prisma migrate command and by
# prisma generate. Same host WITHOUT "-pooler". Migrations must not go through
# the pooler, which cannot hold Prisma's advisory lock.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Supabase (authentication only, no data) ---------------------------------
# Project Settings -> API. Google must be enabled under Authentication ->
# Providers, with http://localhost:3000 in the allowed redirect URLs.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- OMDB --------------------------------------------------------------------
# Free key from https://www.omdbapi.com/apikey.aspx
API_KEY="YOUR_OMDB_KEY"

# --- Upstash Redis (movie search cache) --------------------------------------
# Use the REST URL and REST token, not the redis:// protocol URL.
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# --- Server ------------------------------------------------------------------
# Comma-separated list for multiple origins.
CORS_ORIGIN="http://localhost:3000"
PORT=8080
NODE_ENV=development
