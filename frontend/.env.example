# Copy to frontend/.env.local and fill in. Never commit the real file.
#
# Without this file the Supabase client throws at module load and every page
# fails to render, because supabaseClient.ts asserts both values non-null.

# Backend API base URL, including the /api/v1 prefix.
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# Same Supabase project the backend uses. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
